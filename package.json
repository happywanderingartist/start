{
  "name": "fan-route-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:worker": "node --test tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm test:run && pnpm build && pnpm test:worker",
    "test:assets": "node --test tests/character-assets.test.mjs && node scripts/validate-character-assets.mjs character-assets/character-assets.json",
    "test:contracts": "node --test tests/contracts/*.node.ts",
    "typecheck:foundation": "node node_modules/typescript/bin/tsc -p tsconfig.foundation.json"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.9.5",
    "vite": "6.4.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^27.1.0",
    "pngjs": "7.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
